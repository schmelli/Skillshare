# Postgres connection string for the Docker Compose `postgres` service.
DATABASE_URL=postgresql://skillshare:skillshare@localhost:5432/skillshare

# better-auth
# Generate a strong random secret for real deployments, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Dashboard dev server origin, used for CORS / trustedOrigins.
WEB_ORIGIN=http://localhost:5173
